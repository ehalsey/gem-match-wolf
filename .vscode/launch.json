{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Game (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "preLaunchTask": "npm: dev",
            "serverReadyAction": {
                "pattern": "webpack compiled",
                "uriFormat": "http://localhost:8000",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Launch Game (Edge)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "preLaunchTask": "npm: dev",
            "serverReadyAction": {
                "pattern": "webpack compiled",
                "uriFormat": "http://localhost:8000",
                "action": "debugWithEdge"
            }
        },
        {
            "name": "Attach to Azure Functions",
            "type": "node",
            "request": "attach",
            "restart": true,
            "port": 9229,
            "preLaunchTask": "func: host start"
        },
        {
            "name": "Launch Azure Functions + Azurite",
            "type": "node",
            "request": "attach",
            "restart": true,
            "port": 9229,
            "preLaunchTask": "func: host start with azurite"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Full Stack (Game + API + Azurite)",
            "configurations": [
                "Launch Game (Chrome)",
                "Launch Azure Functions + Azurite"
            ],
            "presentation": {
                "order": 1
            }
        },
        {
            "name": "🎮 Game Only (Chrome)",
            "configurations": [
                "Launch Game (Chrome)"
            ],
            "presentation": {
                "order": 2
            }
        },
        {
            "name": "🎮 Game Only (Edge)",
            "configurations": [
                "Launch Game (Edge)"
            ],
            "presentation": {
                "order": 3
            }
        }
    ]
}